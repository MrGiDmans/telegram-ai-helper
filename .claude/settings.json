{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/credentials.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa)",
      "Edit(**/id_rsa.*)",
      "Edit(**/credentials.json)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/id_rsa)",
      "Write(**/id_rsa.*)",
      "Write(**/credentials.json)",
      "Grep(./.env)",
      "Grep(./.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(cp .env* *)",
      "Bash(copy .env* *)",
      "Bash(Get-Content .env*)"
    ]
  }
}
